; Forward lighting + CSM 4 cascades, atlas 2×2, Vogel PCF 8. texel = 1/atlasSize from CB.
OpCapability Shader
OpCapability SampledImageArrayDynamicIndexing
OpCapability RuntimeDescriptorArray
OpCapability SampledImageArrayNonUniformIndexing
OpCapability ShaderNonUniform
OpExtension "SPV_EXT_descriptor_indexing"
%glsl = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %PSMain "PSMain" %in_world %in_nrm %in_alb %out_color %cb %heap %samp_c
OpExecutionMode %PSMain OriginUpperLeft
OpName %PSMain "PSMain"
OpDecorate %in_world Location 0
OpDecorate %in_nrm Location 1
OpDecorate %in_alb Location 2
OpDecorate %out_color Location 0
OpDecorate %Lighting Block
OpMemberDecorate %Lighting 0 Offset 0
OpMemberDecorate %Lighting 0 ColMajor
OpMemberDecorate %Lighting 0 MatrixStride 16
OpMemberDecorate %Lighting 1 Offset 64
OpMemberDecorate %Lighting 2 Offset 80
OpMemberDecorate %Lighting 3 Offset 96
OpMemberDecorate %Lighting 4 Offset 112
OpMemberDecorate %Lighting 5 Offset 116
OpMemberDecorate %Lighting 6 Offset 120
OpMemberDecorate %Lighting 7 Offset 124
OpMemberDecorate %Lighting 8 Offset 128
OpMemberDecorate %Lighting 9 Offset 132
OpMemberDecorate %Lighting 10 Offset 136
OpMemberDecorate %Lighting 11 Offset 140
OpMemberDecorate %Lighting 12 Offset 144
OpMemberDecorate %Lighting 13 Offset 148
OpMemberDecorate %Lighting 14 Offset 152
OpMemberDecorate %Lighting 15 Offset 156
OpMemberDecorate %Lighting 16 Offset 160
OpMemberDecorate %Lighting 17 Offset 168
OpMemberDecorate %Lighting 18 Offset 176
OpMemberDecorate %Lighting 18 ColMajor
OpMemberDecorate %Lighting 18 MatrixStride 16
OpMemberDecorate %Lighting 19 Offset 240
OpMemberDecorate %Lighting 20 Offset 244
OpMemberDecorate %Lighting 21 Offset 248
OpMemberDecorate %Lighting 22 Offset 252
OpMemberDecorate %Lighting 23 Offset 256
OpMemberDecorate %Lighting 24 Offset 272
OpMemberDecorate %Lighting 24 ColMajor
OpMemberDecorate %Lighting 24 MatrixStride 16
OpMemberDecorate %Lighting 25 Offset 336
OpMemberDecorate %Lighting 25 ColMajor
OpMemberDecorate %Lighting 25 MatrixStride 16
OpMemberDecorate %Lighting 26 Offset 400
OpMemberDecorate %Lighting 26 ColMajor
OpMemberDecorate %Lighting 26 MatrixStride 16
OpMemberDecorate %Lighting 27 Offset 464
OpMemberDecorate %Lighting 27 ColMajor
OpMemberDecorate %Lighting 27 MatrixStride 16
OpDecorate %cb DescriptorSet 0
OpDecorate %cb Binding 0
OpDecorate %heap DescriptorSet 1
OpDecorate %heap Binding 0
OpDecorate %samp_c DescriptorSet 2
OpDecorate %samp_c Binding 1
OpDecorate %ish NonUniform

%void = OpTypeVoid
%fn0 = OpTypeFunction %void
%bool = OpTypeBool
%uint = OpTypeInt 32 0
%float = OpTypeFloat 32
%v2 = OpTypeVector %float 2
%v3 = OpTypeVector %float 3
%v4 = OpTypeVector %float 4
%mat4 = OpTypeMatrix %v4 4

%ptr_in_v3 = OpTypePointer Input %v3
%ptr_out_v4 = OpTypePointer Output %v4
%in_world = OpVariable %ptr_in_v3 Input
%in_nrm = OpVariable %ptr_in_v3 Input
%in_alb = OpVariable %ptr_in_v3 Input
%out_color = OpVariable %ptr_out_v4 Output

%Lighting = OpTypeStruct %mat4 %v4 %v4 %v4 %uint %uint %uint %uint %uint %uint %uint %uint %float %float %float %float %v2 %v2 %mat4 %uint %float %uint %uint %v4 %mat4 %mat4 %mat4 %mat4
%ptr_cb = OpTypePointer Uniform %Lighting
%cb = OpVariable %ptr_cb Uniform
%ptr_u = OpTypePointer Uniform %uint
%ptr_f = OpTypePointer Uniform %float
%ptr_v4u = OpTypePointer Uniform %v4
%ptr_mat = OpTypePointer Uniform %mat4

%img = OpTypeImage %float 2D 0 0 0 1 Unknown
%img_arr = OpTypeRuntimeArray %img
%ptr_arr = OpTypePointer UniformConstant %img_arr
%heap = OpVariable %ptr_arr UniformConstant
%ptr_img = OpTypePointer UniformConstant %img
%samp_ty = OpTypeSampler
%ptr_samp = OpTypePointer UniformConstant %samp_ty
%samp_c = OpVariable %ptr_samp UniformConstant
%sampled = OpTypeSampledImage %img

%u0 = OpConstant %uint 0
%u1 = OpConstant %uint 1
%u2 = OpConstant %uint 2
%u3 = OpConstant %uint 3
%u18 = OpConstant %uint 18
%u19 = OpConstant %uint 19
%u20 = OpConstant %uint 20
%u21 = OpConstant %uint 21
%u23 = OpConstant %uint 23
%u24 = OpConstant %uint 24
%u25 = OpConstant %uint 25
%u26 = OpConstant %uint 26
%u27 = OpConstant %uint 27

%f0 = OpConstant %float 0.0
%f1 = OpConstant %float 1.0
%f05 = OpConstant %float 0.5
%feps = OpConstant %float 0.001
%fbias = OpConstant %float 0.003
%f25 = OpConstant %float 2.5
%f0125 = OpConstant %float 0.125
%famb = OpConstant %float 0.14
%v3_amb = OpConstantComposite %v3 %famb %famb %famb

%t0x = OpConstant %float 0.25000000
%t0y = OpConstant %float 0.00000000
%t1x = OpConstant %float -0.31929009
%t1y = OpConstant %float 0.29249588
%t2x = OpConstant %float 0.04887247
%t2y = OpConstant %float -0.55687654
%t3x = OpConstant %float 0.40244448
%t3y = OpConstant %float 0.52491756
%t4x = OpConstant %float -0.73853511
%t4y = OpConstant %float -0.13063646
%t5x = OpConstant %float 0.69960493
%t5y = OpConstant %float -0.44503139
%t6x = OpConstant %float -0.23400416
%t6y = OpConstant %float 0.87048380
%t7x = OpConstant %float -0.44627131
%t7y = OpConstant %float -0.85926825

%PSMain = OpFunction %void None %fn0
%entry = OpLabel
%world = OpLoad %v3 %in_world
%nrm = OpLoad %v3 %in_nrm
%alb = OpLoad %v3 %in_alb
%world4 = OpCompositeConstruct %v4 %world %f1

%psun = OpAccessChain %ptr_v4u %cb %u2
%sun4 = OpLoad %v4 %psun
%L = OpVectorShuffle %v3 %sun4 %sun4 0 1 2
%pcol = OpAccessChain %ptr_v4u %cb %u3
%sun_c4 = OpLoad %v4 %pcol
%sun_c = OpVectorShuffle %v3 %sun_c4 %sun_c4 0 1 2

%nn = OpExtInst %v3 %glsl Normalize %nrm
%ndot = OpDot %float %nn %L
%ndotl = OpExtInst %float %glsl FMax %ndot %f0

%pcc = OpAccessChain %ptr_u %cb %u21
%cc = OpLoad %uint %pcc
%has = OpINotEqual %bool %cc %u0
OpSelectionMerge %after_sh None
OpBranchConditional %has %do_sh %skip_sh

%skip_sh = OpLabel
OpBranch %after_sh

%do_sh = OpLabel
%pview = OpAccessChain %ptr_mat %cb %u18
%viewM = OpLoad %mat4 %pview
%viewp = OpMatrixTimesVector %v4 %viewM %world4
%vz = OpCompositeExtract %float %viewp 2
%vzd = OpFNegate %float %vz
%pspl = OpAccessChain %ptr_v4u %cb %u23
%spl = OpLoad %v4 %pspl
%sx = OpCompositeExtract %float %spl 0
%sy = OpCompositeExtract %float %spl 1
%sz = OpCompositeExtract %float %spl 2
%lt0 = OpFOrdLessThan %bool %vzd %sx
%lt1 = OpFOrdLessThan %bool %vzd %sy
%lt2 = OpFOrdLessThan %bool %vzd %sz
%id2 = OpSelect %uint %lt2 %u2 %u3
%id1 = OpSelect %uint %lt1 %u1 %id2
%idx = OpSelect %uint %lt0 %u0 %id1

OpSelectionMerge %got_m None
OpSwitch %idx %lc3 0 %lc0 1 %lc1 2 %lc2
%lc0 = OpLabel
%pm0 = OpAccessChain %ptr_mat %cb %u24
%m0 = OpLoad %mat4 %pm0
OpBranch %got_m
%lc1 = OpLabel
%pm1 = OpAccessChain %ptr_mat %cb %u25
%m1 = OpLoad %mat4 %pm1
OpBranch %got_m
%lc2 = OpLabel
%pm2 = OpAccessChain %ptr_mat %cb %u26
%m2 = OpLoad %mat4 %pm2
OpBranch %got_m
%lc3 = OpLabel
%pm3 = OpAccessChain %ptr_mat %cb %u27
%m3 = OpLoad %mat4 %pm3
OpBranch %got_m

%got_m = OpLabel
%cm = OpPhi %mat4 %m0 %lc0 %m1 %lc1 %m2 %lc2 %m3 %lc3
%clip = OpMatrixTimesVector %v4 %cm %world4
%cw = OpCompositeExtract %float %clip 3
%cwm = OpExtInst %float %glsl FMax %cw %feps
%invw = OpFDiv %float %f1 %cwm
%cx = OpCompositeExtract %float %clip 0
%cy = OpCompositeExtract %float %clip 1
%cz = OpCompositeExtract %float %clip 2
%ndx = OpFMul %float %cx %invw
%ndy = OpFMul %float %cy %invw
%ndz = OpFMul %float %cz %invw
%uvx = OpFMul %float %ndx %f05
%uvx1 = OpFAdd %float %uvx %f05
%uvy = OpFMul %float %ndy %f05
%uvy1 = OpFAdd %float %uvy %f05
%txu = OpUMod %uint %idx %u2
%tyu = OpUDiv %uint %idx %u2
%tx = OpConvertUToF %float %txu
%ty = OpConvertUToF %float %tyu
%uvx2 = OpFMul %float %uvx1 %f05
%txh = OpFMul %float %tx %f05
%uvx3 = OpFAdd %float %uvx2 %txh
%uvy2 = OpFMul %float %uvy1 %f05
%tyh = OpFMul %float %ty %f05
%uvy3 = OpFAdd %float %uvy2 %tyh

%pas = OpAccessChain %ptr_f %cb %u20
%asz = OpLoad %float %pas
%texel = OpFDiv %float %f1 %asz
%pcfr = OpFMul %float %f25 %texel

%psh = OpAccessChain %ptr_u %cb %u19
%ish = OpLoad %uint %psh
%pa = OpAccessChain %ptr_img %heap %ish
%ia = OpLoad %img %pa
%sclamp = OpLoad %samp_ty %samp_c
%sm = OpSampledImage %sampled %ia %sclamp

%ox0 = OpFMul %float %t0x %pcfr
%oy0 = OpFMul %float %t0y %pcfr
%sx0 = OpFAdd %float %uvx3 %ox0
%sy0 = OpFAdd %float %uvy3 %oy0
%suv0 = OpCompositeConstruct %v2 %sx0 %sy0
%col0 = OpImageSampleImplicitLod %v4 %sm %suv0
%mz0 = OpCompositeExtract %float %col0 0
%th0 = OpFAdd %float %mz0 %fbias
%lit0 = OpFOrdLessThanEqual %bool %ndz %th0
%bit0 = OpSelect %float %lit0 %f1 %f0

%ox1 = OpFMul %float %t1x %pcfr
%oy1 = OpFMul %float %t1y %pcfr
%sx1 = OpFAdd %float %uvx3 %ox1
%sy1 = OpFAdd %float %uvy3 %oy1
%suv1 = OpCompositeConstruct %v2 %sx1 %sy1
%col1 = OpImageSampleImplicitLod %v4 %sm %suv1
%mz1 = OpCompositeExtract %float %col1 0
%th1 = OpFAdd %float %mz1 %fbias
%lit1 = OpFOrdLessThanEqual %bool %ndz %th1
%bit1 = OpSelect %float %lit1 %f1 %f0
%acc1 = OpFAdd %float %bit0 %bit1

%ox2 = OpFMul %float %t2x %pcfr
%oy2 = OpFMul %float %t2y %pcfr
%sx2 = OpFAdd %float %uvx3 %ox2
%sy2 = OpFAdd %float %uvy3 %oy2
%suv2 = OpCompositeConstruct %v2 %sx2 %sy2
%col2 = OpImageSampleImplicitLod %v4 %sm %suv2
%mz2 = OpCompositeExtract %float %col2 0
%th2 = OpFAdd %float %mz2 %fbias
%lit2 = OpFOrdLessThanEqual %bool %ndz %th2
%bit2 = OpSelect %float %lit2 %f1 %f0
%acc2 = OpFAdd %float %acc1 %bit2

%ox3 = OpFMul %float %t3x %pcfr
%oy3 = OpFMul %float %t3y %pcfr
%sx3 = OpFAdd %float %uvx3 %ox3
%sy3 = OpFAdd %float %uvy3 %oy3
%suv3 = OpCompositeConstruct %v2 %sx3 %sy3
%col3 = OpImageSampleImplicitLod %v4 %sm %suv3
%mz3 = OpCompositeExtract %float %col3 0
%th3 = OpFAdd %float %mz3 %fbias
%lit3 = OpFOrdLessThanEqual %bool %ndz %th3
%bit3 = OpSelect %float %lit3 %f1 %f0
%acc3 = OpFAdd %float %acc2 %bit3

%ox4 = OpFMul %float %t4x %pcfr
%oy4 = OpFMul %float %t4y %pcfr
%sx4 = OpFAdd %float %uvx3 %ox4
%sy4 = OpFAdd %float %uvy3 %oy4
%suv4 = OpCompositeConstruct %v2 %sx4 %sy4
%col4 = OpImageSampleImplicitLod %v4 %sm %suv4
%mz4 = OpCompositeExtract %float %col4 0
%th4 = OpFAdd %float %mz4 %fbias
%lit4 = OpFOrdLessThanEqual %bool %ndz %th4
%bit4 = OpSelect %float %lit4 %f1 %f0
%acc4 = OpFAdd %float %acc3 %bit4

%ox5 = OpFMul %float %t5x %pcfr
%oy5 = OpFMul %float %t5y %pcfr
%sx5 = OpFAdd %float %uvx3 %ox5
%sy5 = OpFAdd %float %uvy3 %oy5
%suv5 = OpCompositeConstruct %v2 %sx5 %sy5
%col5 = OpImageSampleImplicitLod %v4 %sm %suv5
%mz5 = OpCompositeExtract %float %col5 0
%th5 = OpFAdd %float %mz5 %fbias
%lit5 = OpFOrdLessThanEqual %bool %ndz %th5
%bit5 = OpSelect %float %lit5 %f1 %f0
%acc5 = OpFAdd %float %acc4 %bit5

%ox6 = OpFMul %float %t6x %pcfr
%oy6 = OpFMul %float %t6y %pcfr
%sx6 = OpFAdd %float %uvx3 %ox6
%sy6 = OpFAdd %float %uvy3 %oy6
%suv6 = OpCompositeConstruct %v2 %sx6 %sy6
%col6 = OpImageSampleImplicitLod %v4 %sm %suv6
%mz6 = OpCompositeExtract %float %col6 0
%th6 = OpFAdd %float %mz6 %fbias
%lit6 = OpFOrdLessThanEqual %bool %ndz %th6
%bit6 = OpSelect %float %lit6 %f1 %f0
%acc6 = OpFAdd %float %acc5 %bit6

%ox7 = OpFMul %float %t7x %pcfr
%oy7 = OpFMul %float %t7y %pcfr
%sx7 = OpFAdd %float %uvx3 %ox7
%sy7 = OpFAdd %float %uvy3 %oy7
%suv7 = OpCompositeConstruct %v2 %sx7 %sy7
%col7 = OpImageSampleImplicitLod %v4 %sm %suv7
%mz7 = OpCompositeExtract %float %col7 0
%th7 = OpFAdd %float %mz7 %fbias
%lit7 = OpFOrdLessThanEqual %bool %ndz %th7
%bit7 = OpSelect %float %lit7 %f1 %f0
%acc7 = OpFAdd %float %acc6 %bit7
%pcf = OpFMul %float %acc7 %f0125

%in0 = OpFOrdGreaterThanEqual %bool %uvx1 %f0
%in1 = OpFOrdGreaterThanEqual %bool %uvy1 %f0
%in2 = OpFOrdLessThanEqual %bool %uvx1 %f1
%in3 = OpFOrdLessThanEqual %bool %uvy1 %f1
%in4 = OpFOrdGreaterThanEqual %bool %ndz %f0
%in5 = OpFOrdLessThanEqual %bool %ndz %f1
%a0 = OpLogicalAnd %bool %in0 %in1
%a1 = OpLogicalAnd %bool %in2 %in3
%a2 = OpLogicalAnd %bool %in4 %in5
%a3 = OpLogicalAnd %bool %a0 %a1
%inside = OpLogicalAnd %bool %a3 %a2
%sh_on = OpSelect %float %inside %pcf %f1
OpBranch %after_sh

%after_sh = OpLabel
%shadow = OpPhi %float %f1 %skip_sh %sh_on %got_m

%litc = OpVectorTimesScalar %v3 %sun_c %ndotl
%litcs = OpVectorTimesScalar %v3 %litc %shadow
%light = OpFAdd %v3 %v3_amb %litcs
%rgb = OpFMul %v3 %alb %light
%out4 = OpCompositeConstruct %v4 %rgb %f1
OpStore %out_color %out4
OpReturn
OpFunctionEnd
