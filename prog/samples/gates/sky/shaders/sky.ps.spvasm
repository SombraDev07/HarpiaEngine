; Sky composite. The radiance itself lives in the sky-view LUT; this pass maps
; the view ray to that LUT's parameterisation, fetches, adds the sun disc and
; tonemaps. One texel fetch per pixel instead of a 32-step march — that is the
; "scalable" half of Hillaire 2020.
;
; Ends with ACES + sRGB: the swapchain is UNORM.
OpCapability Shader
OpCapability SampledImageArrayDynamicIndexing
OpCapability RuntimeDescriptorArray
OpCapability SampledImageArrayNonUniformIndexing
OpCapability ShaderNonUniform
OpExtension "SPV_EXT_descriptor_indexing"
%glsl = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %PSMain "PSMain" %frag %out_color %cb %heap %samp_c
OpExecutionMode %PSMain OriginUpperLeft
OpName %PSMain "PSMain"
OpDecorate %frag BuiltIn FragCoord
OpDecorate %out_color Location 0
OpDecorate %cb DescriptorSet 0
OpDecorate %cb Binding 0
OpDecorate %heap DescriptorSet 1
OpDecorate %heap Binding 0
OpDecorate %samp_c DescriptorSet 2
OpDecorate %samp_c Binding 1
OpDecorate %iskv NonUniform
OpDecorate %Atmos Block
OpMemberDecorate %Atmos 0 Offset 0
OpMemberDecorate %Atmos 0 ColMajor
OpMemberDecorate %Atmos 0 MatrixStride 16
OpMemberDecorate %Atmos 1 Offset 64
OpMemberDecorate %Atmos 2 Offset 80
OpMemberDecorate %Atmos 3 Offset 96
OpMemberDecorate %Atmos 4 Offset 112
OpMemberDecorate %Atmos 5 Offset 128
OpMemberDecorate %Atmos 6 Offset 144
OpMemberDecorate %Atmos 7 Offset 160
OpMemberDecorate %Atmos 8 Offset 176
OpMemberDecorate %Atmos 9 Offset 192
OpMemberDecorate %Atmos 10 Offset 208
OpMemberDecorate %Atmos 11 Offset 212
OpMemberDecorate %Atmos 12 Offset 216
OpMemberDecorate %Atmos 13 Offset 220
OpMemberDecorate %Atmos 14 Offset 224

%void = OpTypeVoid
%fn0 = OpTypeFunction %void
%bool = OpTypeBool
%uint = OpTypeInt 32 0
%float = OpTypeFloat 32
%v2 = OpTypeVector %float 2
%v3 = OpTypeVector %float 3
%v4 = OpTypeVector %float 4
%mat4 = OpTypeMatrix %v4 4

%ptr_in_v4 = OpTypePointer Input %v4
%ptr_out_v4 = OpTypePointer Output %v4
%frag = OpVariable %ptr_in_v4 Input
%out_color = OpVariable %ptr_out_v4 Output

%Atmos = OpTypeStruct %mat4 %v4 %v4 %v4 %v4 %v4 %v4 %v4 %v4 %v4 %uint %uint %uint %uint %v2
%ptr_cb = OpTypePointer Uniform %Atmos
%cb = OpVariable %ptr_cb Uniform
%ptr_uu = OpTypePointer Uniform %uint
%ptr_uv2 = OpTypePointer Uniform %v2
%ptr_uv4 = OpTypePointer Uniform %v4
%ptr_umat = OpTypePointer Uniform %mat4

%img = OpTypeImage %float 2D 0 0 0 1 Unknown
%img_arr = OpTypeRuntimeArray %img
%ptr_arr = OpTypePointer UniformConstant %img_arr
%heap = OpVariable %ptr_arr UniformConstant
%ptr_img = OpTypePointer UniformConstant %img
%samp_ty = OpTypeSampler
%ptr_samp = OpTypePointer UniformConstant %samp_ty
%samp_c = OpVariable %ptr_samp UniformConstant
%sampled = OpTypeSampledImage %img

%u0 = OpConstant %uint 0
; loop bound is a constant: it pairs with SKYVIEW_STEPS in atmosphere.rs
%nstepsu = OpConstant %uint 32
%u1 = OpConstant %uint 1
%u2 = OpConstant %uint 2
%u3 = OpConstant %uint 3
%u4 = OpConstant %uint 4
%u5 = OpConstant %uint 5
%u6 = OpConstant %uint 6
%u7 = OpConstant %uint 7
%u8 = OpConstant %uint 8
%u9 = OpConstant %uint 9
%u10 = OpConstant %uint 10
%u11 = OpConstant %uint 11
%u12 = OpConstant %uint 12
%u14 = OpConstant %uint 14

%f0 = OpConstant %float 0.0
%f1 = OpConstant %float 1.0
%f05 = OpConstant %float 0.5
%f2 = OpConstant %float 2.0
%f3 = OpConstant %float 3.0
%fn1 = OpConstant %float -1.0
%feps = OpConstant %float 0.000001
%finv4pi = OpConstant %float 0.07957747
%f8pi = OpConstant %float 0.05968310
%f15 = OpConstant %float 1.5
%fpi = OpConstant %float 3.14159265
%fsun_cos = OpConstant %float 0.99995
%v3_zero = OpConstantComposite %v3 %f0 %f0 %f0
%v3_epsv = OpConstantComposite %v3 %feps %feps %feps
%v3_one = OpConstantComposite %v3 %f1 %f1 %f1
%f251 = OpConstant %float 2.51
%f003 = OpConstant %float 0.03
%f243 = OpConstant %float 2.43
%f059 = OpConstant %float 0.59
%f014 = OpConstant %float 0.14
%v3_003 = OpConstantComposite %v3 %f003 %f003 %f003
%v3_059 = OpConstantComposite %v3 %f059 %f059 %f059
%v3_014 = OpConstantComposite %v3 %f014 %f014 %f014
%finvg = OpConstant %float 0.41666666
%v3_invg = OpConstantComposite %v3 %finvg %finvg %finvg

%PSMain = OpFunction %void None %fn0
%entry = OpLabel
%fc = OpLoad %v4 %frag
%pinv = OpAccessChain %ptr_uv2 %cb %u14
%invext = OpLoad %v2 %pinv
%fcxy = OpVectorShuffle %v2 %fc %fc 0 1
%uv = OpFMul %v2 %fcxy %invext
%uvx = OpCompositeExtract %float %uv 0
%uvy = OpCompositeExtract %float %uv 1
%ndx0 = OpFMul %float %uvx %f2
%ndx = OpFSub %float %ndx0 %f1
%ndy0 = OpFMul %float %uvy %f2
%ndy = OpFSub %float %ndy0 %f1

%pivp = OpAccessChain %ptr_umat %cb %u0
%ivp = OpLoad %mat4 %pivp
%farclip = OpCompositeConstruct %v4 %ndx %ndy %f1 %f1
%farw = OpMatrixTimesVector %v4 %ivp %farclip
%fw = OpCompositeExtract %float %farw 3
%fwc = OpExtInst %float %glsl FMax %fw %feps
%invfw = OpFDiv %float %f1 %fwc
%fx = OpCompositeExtract %float %farw 0
%fy = OpCompositeExtract %float %farw 1
%fz = OpCompositeExtract %float %farw 2
%fpx = OpFMul %float %fx %invfw
%fpy = OpFMul %float %fy %invfw
%fpz = OpFMul %float %fz %invfw
%farpos = OpCompositeConstruct %v3 %fpx %fpy %fpz
%pcam = OpAccessChain %ptr_uv4 %cb %u1
%cam4 = OpLoad %v4 %pcam
%camw = OpVectorShuffle %v3 %cam4 %cam4 0 1 2
%alt = OpCompositeExtract %float %cam4 3
%raw = OpFSub %v3 %farpos %camw
%dir = OpExtInst %v3 %glsl Normalize %raw

%psun = OpAccessChain %ptr_uv4 %cb %u2
%sun4 = OpLoad %v4 %psun
%sun0 = OpVectorShuffle %v3 %sun4 %sun4 0 1 2
%sun = OpExtInst %v3 %glsl Normalize %sun0
%pill = OpAccessChain %ptr_uv4 %cb %u3
%ill4 = OpLoad %v4 %pill
%ill = OpVectorShuffle %v3 %ill4 %ill4 0 1 2
%prad = OpAccessChain %ptr_uv4 %cb %u4
%radii = OpLoad %v4 %prad
%bottom = OpCompositeExtract %float %radii 0
%botsq = OpFMul %float %bottom %bottom
%r0 = OpFAdd %float %bottom %alt
%r0sq = OpFMul %float %r0 %r0

; the LUT is parameterised by the view zenith and the azimuth measured against
; the sun, both in the frame whose up is +Y.
%vzcos0 = OpCompositeExtract %float %dir 1
%vzcos = OpExtInst %float %glsl FClamp %vzcos0 %fn1 %f1
%sunup = OpCompositeExtract %float %sun 1
%dirup = OpCompositeExtract %float %dir 1
%sx = OpCompositeExtract %float %sun 0
%sz = OpCompositeExtract %float %sun 2
%dx = OpCompositeExtract %float %dir 0
%dz = OpCompositeExtract %float %dir 2
; projections onto the horizon plane, without normalising (either can be zero)
%dotp = OpFMul %float %sx %dx
%dotp2 = OpFMul %float %sz %dz
%dotpp = OpFAdd %float %dotp %dotp2
%slen0 = OpFMul %float %sx %sx
%slen1 = OpFMul %float %sz %sz
%slen2 = OpFAdd %float %slen0 %slen1
%slen = OpExtInst %float %glsl Sqrt %slen2
%dlen0 = OpFMul %float %dx %dx
%dlen1 = OpFMul %float %dz %dz
%dlen2 = OpFAdd %float %dlen0 %dlen1
%dlen = OpExtInst %float %glsl Sqrt %dlen2
%den0 = OpFMul %float %slen %dlen
%den = OpExtInst %float %glsl FMax %den0 %feps
%lvc0 = OpFDiv %float %dotpp %den
%lvcos = OpExtInst %float %glsl FClamp %lvc0 %fn1 %f1

%vhor0 = OpFSub %float %r0sq %botsq
%vhor1 = OpExtInst %float %glsl FMax %vhor0 %f0
%vhor = OpExtInst %float %glsl Sqrt %vhor1
%cosbeta = OpFDiv %float %vhor %r0
%cbc = OpExtInst %float %glsl FClamp %cosbeta %fn1 %f1
%beta = OpExtInst %float %glsl Acos %cbc
%zenhor = OpFSub %float %fpi %beta
%zenith = OpExtInst %float %glsl Acos %vzcos
%abovehor = OpFOrdLessThan %bool %zenith %zenhor
OpSelectionMerge %gotv None
OpBranchConditional %abovehor %skyhalf %groundhalf

%skyhalf = OpLabel
%zh = OpExtInst %float %glsl FMax %zenhor %feps
%sc0 = OpFDiv %float %zenith %zh
%sc1 = OpFSub %float %f1 %sc0
%sc2 = OpExtInst %float %glsl FMax %sc1 %f0
%sc3 = OpExtInst %float %glsl Sqrt %sc2
%sc4 = OpFSub %float %f1 %sc3
%v_sky = OpFMul %float %sc4 %f05
OpBranch %gotv

%groundhalf = OpLabel
%bt = OpExtInst %float %glsl FMax %beta %feps
%gc0 = OpFSub %float %zenith %zenhor
%gc1 = OpFDiv %float %gc0 %bt
%gc2 = OpExtInst %float %glsl FMax %gc1 %f0
%gc3 = OpExtInst %float %glsl Sqrt %gc2
%gc4 = OpFMul %float %gc3 %f05
%v_gnd = OpFAdd %float %gc4 %f05
OpBranch %gotv

%gotv = OpLabel
%lutv0 = OpPhi %float %v_sky %skyhalf %v_gnd %groundhalf
%lutv = OpExtInst %float %glsl FClamp %lutv0 %f0 %f1
%lu0 = OpFNegate %float %lvcos
%lu1 = OpFMul %float %lu0 %f05
%lu2 = OpFAdd %float %lu1 %f05
%lu3 = OpExtInst %float %glsl FMax %lu2 %f0
%lutu = OpExtInst %float %glsl Sqrt %lu3
%lutuv = OpCompositeConstruct %v2 %lutu %lutv

%pskv = OpAccessChain %ptr_uu %cb %u12
%iskv = OpLoad %uint %pskv
%pskimg = OpAccessChain %ptr_img %heap %iskv
%iskimg = OpLoad %img %pskimg
%sc = OpLoad %samp_ty %samp_c
%smsk = OpSampledImage %sampled %iskimg %sc
%sky4 = OpImageSampleExplicitLod %v4 %smsk %lutuv Lod %f0
%lum = OpVectorShuffle %v3 %sky4 %sky4 0 1 2

; sun disc, only above the horizon
%cos_t = OpDot %float %dir %sun
%is_sun = OpFOrdGreaterThan %bool %cos_t %fsun_cos
%up_ok = OpFOrdGreaterThan %bool %dirup %f0
%draw_sun = OpLogicalAnd %bool %is_sun %up_ok
%disc0 = OpFMul %v3 %lum %ill
%disc = OpSelect %v3 %draw_sun %disc0 %v3_zero
%total = OpFAdd %v3 %lum %disc

%x251 = OpVectorTimesScalar %v3 %total %f251
%numt = OpFAdd %v3 %x251 %v3_003
%num = OpFMul %v3 %total %numt
%x243 = OpVectorTimesScalar %v3 %total %f243
%dent = OpFAdd %v3 %x243 %v3_059
%denA = OpFMul %v3 %total %dent
%denC = OpFAdd %v3 %denA %v3_014
%toned0 = OpFDiv %v3 %num %denC
%toned = OpExtInst %v3 %glsl FClamp %toned0 %v3_zero %v3_one
%srgb = OpExtInst %v3 %glsl Pow %toned %v3_invg
%out4 = OpCompositeConstruct %v4 %srgb %f1
OpStore %out_color %out4
OpReturn
OpFunctionEnd
